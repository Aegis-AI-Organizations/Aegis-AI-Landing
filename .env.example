# Run npm run cms:setup to generate a local secret. Never commit real secrets.
PAYLOAD_SECRET=
DATABASE_URI=file:./aegis-content.db
MEDIA_DIR=media
SITE_URL=http://localhost:3001

# Mailpit locally; replace with your SMTP provider later. Never commit credentials.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_REQUIRE_TLS=false
SMTP_FROM_ADDRESS=noreply@aegis.test
# SMTP_USER=
# SMTP_PASSWORD=
# Private first-admin provisioning, remove after initialization:
# CMS_BOOTSTRAP_EMAIL=
# CMS_BOOTSTRAP_PASSWORD_FILE=/run/secrets/cms-admin-password
# CMS_BOOTSTRAP_NAME=Administration Aegis
